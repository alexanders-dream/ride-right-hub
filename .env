# Environment Variables for MotoMarket
# Change these values in production!

# Frontend URL
VITE_FRONTEND_URL=http://localhost:8080

# API URL
VITE_API_URL=http://localhost:3000/api

# JWT Secret for token signing (change to a secure random string)
VITE_JWT_SECRET=demo-token-secret-change-in-production-environment

# Database settings (for future backend integration)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motomarket?schema=public"
API_BASE_URL=http://localhost:3000/api