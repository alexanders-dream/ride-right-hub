# PesaPal Configuration - DEVELOPMENT SETUP
# For development, use sandbox environment and ngrok URLs
PESAPAL_CONSUMER_KEY=YOUR_PESAPAL_SANDBOX_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=YOUR_PESAPAL_SANDBOX_CONSUMER_SECRET
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CALLBACK_URL=http://localhost:3002/api/payments/pesapal/callback
PESAPAL_CANCELLATION_URL=http://localhost:3002/api/payments/pesapal/cancelled
CALLBACK_BASE_URL=http://localhost:3002

# Application Configuration
VITE_API_BASE_URL=http://localhost:3002/api
FRONTEND_URL=http://localhost:8082
BACKEND_URL=http://localhost:3002

# Database Configuration
DATABASE_PATH=ride-right-hub.db

# JWT Configuration
JWT_SECRET=ride-right-hub-secret-key-change-in-production
JWT_EXPIRY=7d

# Email Configuration (for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Application Settings
NODE_ENV=development
PORT=3002
VITE_PORT=8082
