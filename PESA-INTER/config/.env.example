# PESA-INTER Package - Environment Configuration Template
# Copy this file to .env and update the values for your project

# ============================================================================
# BUSINESS CONFIGURATION
# ============================================================================
BUSINESS_NAME=Your Business Name
FRONTEND_URL=http://localhost:3000
CALLBACK_BASE_URL=http://localhost:3000

# ============================================================================
# PESAPAL CONFIGURATION
# ============================================================================
# Production PesaPal Credentials
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret_here
PESAPAL_ENVIRONMENT=production

# Sandbox PesaPal Credentials (for testing)
# PESAPAL_CONSUMER_KEY=qkio1BGGYAXTu2JOfm7XSXNjRrK5NPlJ
# PESAPAL_CONSUMER_SECRET=osGQ364R49cXKeOYSpaOnT++rHs=
# PESAPAL_ENVIRONMENT=sandbox

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=info
# Options: error, warn, info, http, debug

# ============================================================================
# PAYMENT STORAGE CONFIGURATION
# ============================================================================
# Directory for storing payment files (relative to project root)
PAYMENT_STORAGE_DIR=Payment

# Enable/disable file storage (true/false)
ENABLE_FILE_STORAGE=true

# Enable/disable database storage (true/false)
ENABLE_DATABASE_STORAGE=false

# ============================================================================
# DATABASE CONFIGURATION (Optional)
# ============================================================================
# MongoDB connection string (if using database storage)
# MONGODB_URI=mongodb://localhost:27017/your_database_name

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Session secret for Express sessions
SESSION_SECRET=your_session_secret_here_change_in_production

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Rate limiting window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Payment initialization rate limit (per 15 minutes)
PAYMENT_INIT_RATE_LIMIT=10

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# SMTP configuration for payment notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# FROM_EMAIL=noreply@yourbusiness.com

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================
# Webhook secret for validating incoming webhooks
# WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
# Enable debug logging (true/false)
DEBUG_MODE=false

# Enable test endpoints in development (true/false)
ENABLE_TEST_ENDPOINTS=true

# ============================================================================
# PRODUCTION CONFIGURATION
# ============================================================================
# SSL configuration for production
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/key.pem

# Trusted proxy settings
# TRUST_PROXY=true

# ============================================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================================
# Google Analytics tracking ID
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn_here

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env and update the values
# 2. Never commit .env file to version control
# 3. Use strong, unique secrets for production
# 4. Regularly rotate API keys and secrets
# 5. Test with sandbox credentials before going live
